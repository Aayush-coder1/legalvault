# ---- MongoDB Atlas (YOU FILL, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/legalvault) ----
MONGO_URI=

# ---- Ports (pre-filled) ----
AUTH_PORT=4001
CASE_PORT=4002
FILE_PORT=4003
CRYPTO_PORT=4004
FRONTEND_URL=http://localhost:3000
# Inside Docker, services reach each other by service name (not localhost)
CRYPTO_PROXY_URL=http://crypto-proxy:4004
JWKS_URL=http://auth-service:4001/auth/jwks.json

# ---- JWT RS256 (YOU FILL private/public, see scripts/generate-jwt-keys.js) ----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=legalvault-1
JWT_ISSUER=legalvault-auth
JWT_AUDIENCE=legalvault-app
ACCESS_TTL=15m
REFRESH_TTL=7d

# ---- Crypto-proxy master key (YOU FILL, base64 32 bytes) ----
CRYPTO_MASTER_KEY=

# ---- Backblaze B2 file storage (YOU FILL) ----
# B2_ENDPOINT = your bucket's "S3 Endpoint", e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
B2_REGION=us-east-1
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
